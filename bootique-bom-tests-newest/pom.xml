                                <exclude>src/main/resources/io/bootique/bom/cayenne/datamap.map.xml</exclude>
                                <exclude>src/main/resources/templates/io/bootique/bom/mvc/r1/t1.mustache</exclude>
                                <exclude>**/*.yml</exclude>
                                <exclude>**/*.json</exclude>
                                <exclude>derby.log</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
