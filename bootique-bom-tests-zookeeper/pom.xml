<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.bootique.bom</groupId>
        <artifactId>bootique-bom-parent</artifactId>
        <version>4.0-SNAPSHOT</version>
    </parent>

    <artifactId>bootique-bom-tests-zookeeper</artifactId>
    <packaging>jar</packaging>

    <name>bootique-bom-tests-zookeeper: Bootique BOM integration tests, zookeeper job locks</name>
    <description>Integration tests for the ZooKeeper-based job lock provider, which is mutually exclusive with bootique-job-consul.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.bootique.bom</groupId>
                <artifactId>bootique-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Mutually exclusive job lock provider -->
        <dependency>
            <groupId>io.bootique.job</groupId>
            <artifactId>bootique-job-zookeeper</artifactId>
        </dependency>
        <dependency>
            <groupId>io.bootique.curator</groupId>
            <artifactId>bootique-curator</artifactId>
        </dependency>

        <!-- Version-neutral modules the lock provider is expected to coexist with -->
        <dependency>
            <groupId>io.bootique.job</groupId>
            <artifactId>bootique-job</artifactId>
        </dependency>
        <dependency>
            <groupId>io.bootique.job</groupId>
            <artifactId>bootique-job-instrumented</artifactId>
        </dependency>
        <dependency>
            <groupId>io.bootique.logback</groupId>
            <artifactId>bootique-logback</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>io.bootique</groupId>
            <artifactId>bootique-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Checking that the BOM produces a consistent dependency graph. Intentionally declared here and -->
            <!-- not in the parent POM, so that it applies to the test modules only, and never to the BOM itself. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-dependency-versions</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Fails when Maven's "nearest wins" resolution picks a version lower than -->
                                <!-- some other path requires, i.e. a silent downgrade -->
                                <requireUpperBoundDeps />

                                <!-- Fails when any two paths disagree on a version at all -->
                                <dependencyConvergence />

                                <banDuplicatePomDependencyVersions />
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
